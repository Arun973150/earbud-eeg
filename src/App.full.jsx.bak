import { useEffect, useRef } from 'react'
import Nav from './components/Nav.jsx'
import ParticleBrain from './components/ParticleBrain.jsx'
import { STATS, OBJECTIVES, PIPELINE, STACK, METRICS, TEAM, GUIDE, FUTURE } from './data.js'

/* Reveal-on-scroll: adds .in to .reveal elements as they enter the viewport */
function useReveal() {
  useEffect(() => {
    const els = document.querySelectorAll('.reveal')
    if (!('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('in'))
      return
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in')
            io.unobserve(e.target)
          }
        })
      },
      { threshold: 0.12 },
    )
    els.forEach((el) => io.observe(el))
    return () => io.disconnect()
  }, [])
}

function Eyebrow({ children }) {
  return (
    <p className="eyebrow">
      <span className="tick">◆ </span>
      {children}
    </p>
  )
}

function Hero() {
  return (
    <header className="hero" id="top">
      <div className="hero__brain">
        <ParticleBrain />
      </div>
      <div className="hero__veil" />

      <span className="hero__edge hero__edge--left">Out of the lab</span>
      <span className="hero__edge hero__edge--right">Into everyday life</span>

      <div className="hero__content">
        <Eyebrow>MSRIT · CSP67 Mini Project · 2026</Eyebrow>
        <h1 className="hero__display">
          Brain activity,
          <br />
          made <span className="accent">wearable</span>
        </h1>
        <p className="hero__sub">
          An earbud-based EEG monitoring system — dry in-ear electrodes and a hybrid
          CNN-GRU model that detect seizures in real time, no gel, no lab, no wires.
        </p>
        <div className="hero__actions">
          <a className="pill" href="#overview">Explore the system</a>
          <a className="pill pill--accent" href="#results">See the results</a>
        </div>
      </div>

      <a className="hero__scroll" href="#overview" aria-label="Scroll to overview">
        <span>Scroll</span>
        <span className="line" />
      </a>
    </header>
  )
}

function Stats() {
  return (
    <section className="stats">
      <div className="container">
        <div className="stats__grid reveal">
          {STATS.map((s) => (
            <div className="stat" key={s.label}>
              <div className="stat__value">
                {s.value}
                {s.unit && <span className="unit"> {s.unit}</span>}
              </div>
              <div className="stat__label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

function Overview() {
  return (
    <section className="section" id="overview">
      <div className="container">
        <div className="section__head reveal">
          <Eyebrow>The idea</Eyebrow>
          <h2 className="statement">EEG that lives in your ears, not the hospital</h2>
          <p className="lead">
            Conventional EEG is bulky, gel-bound and stuck in clinics. We embed dry
            electrodes inside a 3D-printed earbud to capture temporal-lobe activity
            continuously and comfortably — then process it in real time and flag
            seizure-like patterns with deep learning.
          </p>
        </div>
      </div>
    </section>
  )
}

function Problem() {
  const rows = [
    { k: 'Bulky & tethered', v: 'Scalp EEG needs many wet electrodes, conductive gel and trained technicians.' },
    { k: 'Clinic-bound', v: 'Wired setups confine monitoring to hospitals and labs — not daily life.' },
    { k: 'Fragile signals', v: 'Ear-EEG is low-amplitude and sensitive to motion, muscle and powerline noise.' },
    { k: 'No full pipeline', v: 'Most wearables only acquire — they lack integrated real-time intelligent analysis.' },
  ]
  return (
    <section className="section" id="problem">
      <div className="container">
        <div className="split">
          <div className="section__head reveal" style={{ marginBottom: 0 }}>
            <Eyebrow>The problem</Eyebrow>
            <h2 className="statement">Why conventional EEG can't follow you home</h2>
            <p className="lead">
              The research gap is clear: a low-cost, comfortable, wearable system that
              integrates dry electrodes, robust preprocessing and intelligent analysis for
              continuous real-world monitoring.
            </p>
          </div>
          <div className="contrast reveal">
            {rows.map((r) => (
              <div className="contrast__row" key={r.k}>
                <div className="k">{r.k}</div>
                <div className="v">{r.v}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

