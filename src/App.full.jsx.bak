                {METRICS.map((m) => (
                  <tr key={m.model} className={m.proposed ? 'is-proposed' : ''}>
                    <td>{m.model}</td>
                    <td>{m.sens}%</td>
                    <td>{m.spec}%</td>
                    <td>{m.f1}</td>
                    <td>{m.auc}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div className="reveal">
            <p className="eyebrow" style={{ marginBottom: 'var(--sp-16)' }}>Confusion matrix · test set</p>
            <div className="confusion">
              <span className="axis" />
              <span className="axis">Pred. seizure</span>
              <span className="axis">Pred. normal</span>

              <span className="axis" style={{ writingMode: 'vertical-rl', transform: 'rotate(180deg)' }}>Seizure</span>
              <div className="cell hit"><div className="big">480</div><div className="pct">97.6%</div></div>
              <div className="cell"><div className="big">12</div><div className="pct">2.4%</div></div>

              <span className="axis" style={{ writingMode: 'vertical-rl', transform: 'rotate(180deg)' }}>Normal</span>
              <div className="cell"><div className="big">18</div><div className="pct">3.4%</div></div>
              <div className="cell hit"><div className="big">510</div><div className="pct">96.6%</div></div>
            </div>
            <p className="lead" style={{ marginTop: 'var(--sp-20)', fontSize: 'var(--text-body-sm)' }}>
              ~96% accuracy with minimal false positives and negatives, at a ~380 ms
              end-to-end latency suitable for continuous real-time monitoring.
            </p>
          </div>
        </div>
      </div>
    </section>
  )
}

