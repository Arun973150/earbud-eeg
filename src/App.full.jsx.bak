function Results() {
  return (
    <section className="section" id="results">
      <div className="container">
        <div className="section__head reveal">
          <Eyebrow>Results</Eyebrow>
          <h2 className="statement">The CNN-GRU model leads across every metric</h2>
          <p className="lead">
            Evaluated on temporal-lobe EEG, the hybrid model beats SVM, CNN-only and
            LSTM-only baselines — the sensitivity gain matters most, since it reduces
            missed seizures.
          </p>
        </div>

        <div className="results-grid">
          <div className="reveal">
            <table className="metrics">
              <thead>
                <tr>
                  <th>Model</th>
                  <th>Sensitivity</th>
                  <th>Specificity</th>
                  <th>F1</th>
                  <th>AUC</th>
                </tr>
