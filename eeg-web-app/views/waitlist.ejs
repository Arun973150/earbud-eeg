<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hardware Waitlist - Earbud EEG</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600&family=Inter:wght@400;500;600&family=Roboto+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/theme.css" />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/dashboard" aria-label="Earbud EEG dashboard">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z" fill="#ffffff" />
          <path d="M12 7 L13 11 L17 12 L13 13 L12 17 L11 13 L7 12 L11 11 Z" fill="#d9963f" />
        </svg>
        <b>EARBUD<span>&middot;</span>EEG</b>
      </a>
      <div class="topbar__right">
        <a class="btn" href="/dashboard">Dashboard</a>
      </div>
    </header>

    <main class="shell">
      <section class="page-head">
        <p class="eyebrow">Early access</p>
        <h1>Join The Waitlist</h1>
        <p class="sub"><%= featureInfo.description %></p>
      </section>

      <div class="stack">
        <% if (submitted) { %>
          <section class="panel notice-panel good">
            <p class="panel__eyebrow">Waitlist joined</p>
            <h2 class="panel__title">You're on the list</h2>
            <p class="panel__desc">
              Thanks, your details have been taken. We're aiming to release Earbud&middot;EEG
              by 2028, and we'll be reaching out to you as soon as access opens.
            </p>
            <div class="btn-row" style="margin-top: 20px">
              <a class="btn btn--primary" href="/dashboard">Back to dashboard</a>
            </div>
          </section>
        <% } else { %>
          <section class="panel">
            <p class="panel__eyebrow">Early access</p>
            <h2 class="panel__title">Add your details</h2>
            <p class="panel__desc">
              Earbud EEG is launching soon. Add your name and email and we'll let you
              know the moment access opens.
            </p>

            <% if (notice) { %>
              <div class="inline-notice"><%= notice %></div>
            <% } %>
            <% if (errorMessage) { %>
              <div class="inline-notice error"><%= errorMessage %></div>
            <% } %>

            <form action="/waitlist" method="POST" class="waitlist-form">
              <div class="field">
                <label for="name">Name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  value="<%= formData.name || '' %>"
                  placeholder="Your name"
                />
              </div>
              <div class="field">
                <label for="email">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  value="<%= formData.email || '' %>"
                  placeholder="you@example.com"
                  required
                />
              </div>
              <div class="field">
                <label for="notes">What do you want to use it for?</label>
                <textarea id="notes" name="notes" placeholder="Optional"><%= formData.notes || '' %></textarea>
              </div>
              <div class="btn-row" style="justify-content: flex-end; margin-top: 20px">
                <a href="/dashboard" class="btn">Back</a>
                <button type="submit" class="btn btn--primary">Join waitlist</button>
              </div>
            </form>
          </section>
        <% } %>
      </div>
    </main>

    <footer>EEG Analysis System</footer>
  </body>
</html>
