<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EEG Analysis Results - Earbud EEG</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600&family=Inter:wght@400;500;600&family=Roboto+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/theme.css" />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/dashboard" aria-label="Earbud EEG dashboard">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z" fill="#ffffff" />
          <path d="M12 7 L13 11 L17 12 L13 13 L12 17 L11 13 L7 12 L11 11 Z" fill="#d9963f" />
        </svg>
        <b>EARBUD<span>&middot;</span>EEG</b>
      </a>
      <div class="topbar__right">
        <a class="btn" href="/dashboard">Dashboard</a>
        <a class="btn btn--primary" href="/waitlist?feature=prediction">Join prediction waitlist</a>
      </div>
    </header>

    <main class="shell">
      <section class="page-head">
        <p class="eyebrow">Live capture complete</p>
        <h1>EEG Analysis Results</h1>
        <p class="sub">Patient <%= patientId %> / <%= duration %> seconds</p>
      </section>

      <div class="stack">
        <section class="panel">
          <p class="panel__eyebrow">Visualization</p>
          <h2 class="panel__title">EEG signal and power spectrum</h2>
          <% if (imageFile) { %>
            <figure class="figure">
              <img src="/eeg_data/<%= imageFile %>" alt="EEG analysis graph" />
            </figure>
          <% } else { %>
            <p class="note">No visualization was generated. Check the system output below.</p>
          <% } %>
        </section>

        <section class="panel">
          <p class="panel__eyebrow">Files</p>
          <h2 class="panel__title">Downloads</h2>
          <div class="btn-row">
            <% if (edfFile) { %>
              <a href="/eeg_data/<%= edfFile %>" download class="btn btn--primary">Download EDF</a>
            <% } %>
            <% if (imageFile) { %>
              <a href="/eeg_data/<%= imageFile %>" download class="btn">Download plot</a>
            <% } %>
            <a href="/waitlist?feature=analysis" class="btn">Join analysis waitlist</a>
          </div>
        </section>

        <% if (reportContent) { %>
          <section class="panel">
            <p class="panel__eyebrow">Report</p>
            <h2 class="panel__title">Signal summary</h2>
            <pre><%= reportContent %></pre>
          </section>
        <% } %>

        <section class="panel collapsible active">
          <h2 class="panel__title">System output</h2>
          <div class="collapsible-content">
            <pre><%= pythonOutput %></pre>
          </div>
        </section>

        <section class="panel">
          <p class="panel__eyebrow">Assistant</p>
          <h2 class="panel__title">Ask about these results</h2>
          <div id="chat-output"></div>
          <form id="chat-form" data-page="recording">
            <input type="text" id="chat-input" placeholder="Ask about this EEG analysis" />
            <button type="submit">Send</button>
          </form>
        </section>
      </div>
    </main>

    <footer>EEG Analysis System</footer>
    <script src="/js/main.js"></script>
  </body>
</html>
