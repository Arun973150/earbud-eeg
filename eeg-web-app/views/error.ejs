<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error - Earbud EEG</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600&family=Inter:wght@400;500;600&family=Roboto+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/theme.css" />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/dashboard" aria-label="Earbud EEG dashboard">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z" fill="#ffffff" />
          <path d="M12 7 L13 11 L17 12 L13 13 L12 17 L11 13 L7 12 L11 11 Z" fill="#d9963f" />
        </svg>
        <b>EARBUD<span>&middot;</span>EEG</b>
      </a>
      <div class="topbar__right">
        <a class="btn" href="/dashboard">Dashboard</a>
        <a class="btn btn--primary" href="/waitlist?feature=hardware">Join waitlist</a>
      </div>
    </header>

    <main class="shell">
      <section class="page-head">
        <p class="eyebrow">Action needed</p>
        <h1><%= error %></h1>
      </section>

      <div class="stack">
        <section class="panel">
          <p class="panel__eyebrow">Details</p>
          <pre><%= details %></pre>
          <div class="btn-row" style="margin-top: 18px">
            <a href="/dashboard" class="btn">Back to dashboard</a>
            <a href="/waitlist?feature=hardware" class="btn btn--primary">Join waitlist</a>
          </div>
        </section>
      </div>
    </main>

    <footer>EEG Analysis System</footer>
  </body>
</html>
