<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seizure Prediction Results - Earbud EEG</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600&family=Inter:wght@400;500;600&family=Roboto+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/theme.css" />
  </head>
  <body>
    <%
      var isSeizure = prediction === 'SEIZURE';
      var displayConfidence = parseFloat(String(confidence).replace('%', '')) || 0;
      displayConfidence = Math.max(0, Math.min(100, displayConfidence));
    %>
    <header class="topbar">
      <a class="brand" href="/dashboard" aria-label="Earbud EEG dashboard">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z" fill="#ffffff" />
          <path d="M12 7 L13 11 L17 12 L13 13 L12 17 L11 13 L7 12 L11 11 Z" fill="#d9963f" />
        </svg>
        <b>EARBUD<span>&middot;</span>EEG</b>
      </a>
      <div class="topbar__right">
        <a class="btn" href="/dashboard">Dashboard</a>
        <a class="btn btn--primary" href="/waitlist?feature=prediction">Join waitlist</a>
      </div>
    </header>

    <main class="shell">
      <section class="page-head">
        <p class="eyebrow">CNN-GRU detector</p>
        <h1>Seizure Prediction Results</h1>
        <p class="sub"><%= fileName %></p>
      </section>

      <div class="stack">
        <section class="panel">
          <p class="panel__eyebrow">Prediction</p>
          <div class="verdict <%= isSeizure ? 'bad' : 'good' %>">
            <span class="dot" aria-hidden="true"></span>
            <span><%= prediction %></span>
          </div>
          <div class="meter-label">
            <span>Confidence</span>
            <span><%= displayConfidence.toFixed(2) %>%</span>
          </div>
          <div class="meter">
            <span
              style="width: <%= displayConfidence %>%; background: <%= isSeizure ? '#e06b6b' : '#189b81' %>;"
            ></span>
          </div>
        </section>

        <% if (visualizationFile) { %>
          <section class="panel">
            <p class="panel__eyebrow">Visualization</p>
            <h2 class="panel__title">Signal breakdown</h2>
            <figure class="figure">
              <img src="/eeg_data/<%= visualizationFile %>" alt="EEG seizure prediction visualization" />
            </figure>
          </section>
        <% } %>

        <section class="panel">
          <p class="panel__eyebrow">Next steps</p>
          <h2 class="panel__title">Continue analysis</h2>
          <div class="btn-row">
            <a href="/waitlist?feature=prediction" class="btn btn--primary">Join prediction waitlist</a>
            <a href="/dashboard" class="btn">Back to dashboard</a>
          </div>
        </section>

        <section class="panel collapsible">
          <h2 class="panel__title">Technical details</h2>
          <div class="collapsible-content">
            <pre><%= pythonOutput %></pre>
          </div>
        </section>
      </div>
    </main>

    <footer>EEG Analysis System</footer>
    <script src="/js/main.js"></script>
  </body>
</html>
